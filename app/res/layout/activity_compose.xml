<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/c_bg">

    <LinearLayout style="@style/Header">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/IconBtnAccent"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/HeaderTitle"
            android:text="@string/title_new" />

        <ImageView
            android:id="@+id/btnSend"
            style="@style/IconBtnAccent"
            android:src="@drawable/ic_send" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/c_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <Spinner
            android:id="@+id/spinnerAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/field_bg"
            android:paddingLeft="10dp"
            android:paddingRight="10dp" />

        <EditText
            android:id="@+id/to"
            style="@style/Field"
            android:hint="Кому: адрес"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/subject"
            style="@style/Field"
            android:hint="Тема"
            android:inputType="textCapSentences" />

        <EditText
            android:id="@+id/body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/field_bg"
            android:gravity="top|start"
            android:padding="14dp"
            android:hint="Текст письма"
            android:textSize="15sp"
            android:textColor="?attr/c_text"
            android:textColorHint="?attr/c_text2"
            android:inputType="textCapSentences|textMultiLine"
            android:scrollbars="vertical" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/c_bar"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/btnAttach"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Прикрепить"
                android:drawableStart="@drawable/ic_attach"
                android:drawablePadding="6dp"
                android:drawableTint="?attr/c_on_accent"
            android:textSize="14sp"
            android:textColor="?attr/c_accent" />

        <TextView
            android:id="@+id/attachName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:singleLine="true"
            android:ellipsize="middle"
            android:textSize="12sp"
            android:textColor="?attr/c_text2" />
    </LinearLayout>
</LinearLayout>
